ions":[{"name":"INRAE","name_original":"INRA, UMR1069 Sol Agro et hydrosystème Spatialisation, 65 rue de Saint-Brieuc, CS 84215, 35042 Rennes Cedex, France","ids":[{"type":"magid","value":"2164319894"},{"type":"grid","value":"grid.418921.4"},{"type":"fundref","value":"100012481"},{"type":"wikidata","value":"Q3152477"},{"type":"ror","value":"003vg9w96"}],"grid_id":"grid.418921.4","country_code":"FR"}]},{"first_name":"Jean","last_name":"Petit","initials":"J","ids":[{"type":"magid","value":"2211287418"}],"affiliations":[{"name":"INRAE","name_original":"INRA, UMR1069 Sol Agro et hydrosystème Spatialisation, 65 rue de Saint-Brieuc, CS 84215, 35042 Rennes Cedex, France","ids":[{"type":"magid","value":"2164319894"},{"type":"grid","value":"grid.418921.4"},{"type":"fundref","value":"100012481"},{"type":"wikidata","value":"Q3152477"},{"type":"ror","value":"003vg9w96"}],"grid_id":"grid.418921.4","country_code":"FR"}]}],"source":{"title":"Agriculture, Ecosystems & Environment","type":"Journal","publisher":"Elsevier BV","issn":[{"type":"print","value":"01678809"},{"type":"unknown","value":"18732283"}],"country":"Netherlands","asjc_codes":["1102","2306"],"asjc_subjects":["General Agricultural and Biological Sciences","Agronomy and Crop Science"]},"fields_of_study":["Environmental science","Organic farming","Agriculture","Aquaculture","Rainbow trout","Environmental impact assessment","Life-cycle assessment","Fish farming","Trout","Environmental impact"],"volume":"130","issue":"4","languages":["en"],"start_page":"210","end_page":"220","is_open_access":false,"abstract":"The environmental impacts of conventional and organic trout farming were compared using life cycle assessment (LCA). The study was based on data from 10 conventional and 10 organic French trout farms. The environmental impacts of the production of 1 t of live fish at the farm gate were calculated for eight impact categories. Feed production was the major contributor to most environmental impacts. Organic trout farming had higher impacts for energy use, climate change, eutrophication and land occupation than conventional farming, largely because of lower feed conversion efficiency and lower stocking densities. Organic systems had lower impacts for net primary production use and dependency on wild fish resources because of restrictions on fishmeal and fish oil use. The results highlight trade-offs between different environmental objectives in aquaculture production systems."}},"provenance":{"recovery":"final_master_missing_exact_lens_id"}}
{"identity":{"lens_id":"024-467-394-778-974","record_id":"024-467-394-778-974","record_id_type":"lens_id"},"source":{"provider":"lens","source_format":"lens_api_json"},"lens":{"raw_payload":{"lens_id":"024-467-394-778-974","title":"Modulation of Infectious Salmon Anaemia Virus Infection by Clathrin-Mediated Endocytosis and Macropinocytosis Inhibitors","publication_type":"journal article","year_published":2013,"date_published_parts":[2013,10,18],"created":"2018-05-12T20:06:31.567000+00:00","external_ids":[{"type":"doi","value":"10.1371/journal.pone.0079176"},{"type":"pmid","value":"24223918"},{"type":"pmcid","value":"PMC3813595"},{"type":"magid","value":"2091596382"}],"open_access":{"locations":{"landing_page_urls":["https://www.ncbi.nlm.nih.gov/pmc/articles/3813595","https://doi.org/10.1371/journal.pone.0079176"],"pdf_urls":["https://www.ncbi.nlm.nih.gov/pmc/articles/3813595/pdf"]},"license":"CC BY","colour":"gold"},"authors":[{"first_name":"María","last_name":"Cárdenas","initials":"M","ids":[{"type":"magid","value":"2131354585"}]},{"first_name":"Cristian","last_name":"Cortez-San Martín","initials":"C","ids":[{"type":"magid","value":"2083241885"}]},{"first_name":"Marcela","last_name":"Cortés","initials":"M","ids":[{"type":"magid","value":"2099173370"}]},{"first_name":"Juan","last_name":"Vera","initials":"J","ids":[{"type":"magid","value":"2119128788"}]},{"first_name":"Alejandro","last_name":"Reyes-López","initials":"A","ids":[{"type":"magid","value":"2113897813"}]},{"first_name":"María","last_name":"Sandino","initials":"M","ids":[{"type":"magid","value":"2154936381"}]},{"first_name":"Fernando","last_name":"Mardones","initials":"F","ids":[{"type":"magid","value":"2109264469"}]},{"first_name":"Patricio","last_name":"Smith","initials":"P","ids":[{"type":"magid","value":"2107714984"}]}],"source":{"title":"PLoS ONE","type":"Journal","publisher":"Public Library of Science (PLoS)","issn":[{"type":"electronic","value":"19326203"}],"country":"United States","asjc_codes":["1000"],"asjc_subjects":["Multidisciplinary"]},"fields_of_study":["Biology","Virus","Endocytosis","Infectious salmon anemia virus","Macropinocytosis","Clathrin","Cell biology","Infection","Pathology","Inhibitor"],"volume":"8","issue":"10","languages":["en"],"start_page":"e79176","is_open_access":true,"abstract":"Infectious salmon anaemia virus (ISAV) is an orthomyxovirus causing severe disease in Atlantic salmon. This study evaluated the roles of clathrin-mediated endocytosis and macropinocytosis during ISAV entry using pharmacological inhibitors in salmon cell cultures. Inhibition of clathrin-mediated endocytosis reduced viral internalisation and replication, while inhibitors of macropinocytosis also decreased infection. The findings indicate that ISAV can use multiple endocytic pathways to enter susceptible cells, providing insight into mechanisms of infection and potential intervention targets."}},"provenance":{"recovery":"final_master_missing_exact_lens_id"}}
