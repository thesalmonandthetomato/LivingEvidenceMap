{
  "schema_version": "fulltext_coding_v1",
  "description": "Closed full-text coding schema aligned with the FRB Blue Food data extraction sheet, with LivingEvidenceMap topic ontology coding added.",
  "document_type": ["study", "review", "perspective", "commentary", "editorial", "book", "book_chapter", "report", "thesis", "protocol", "other"],
  "review_type": ["primer_overview", "systematic_style", "not_applicable"],
  "study_type": ["experimental", "observational", "modelling", "not_stated", "not_applicable"],
  "study_design": ["BA", "CI", "BACI", "RCT", "Time-series", "Modelling", "Qualitative", "not_stated", "not_applicable"],
  "research_approach": ["quantitative", "qualitative", "mixed_methods", "not_applicable"],
  "setting": ["field", "laboratory/controlled facility", "in_vitro", "in_silico"],
  "production_stage": ["Feed", "Hatchery", "Transfer between Hatchery and Adult", "Adult grow-out", "Processing"],
  "fish_life_stage": ["Sperm", "Egg", "Embryo", "Alevin", "Fry", "Parr", "Smolt", "Juvenile", "Adult", "Broodstock", "Harvest", "Product"],
  "aquaculture_facility": ["salmon_farming_region", "hatchery", "open_cages", "closed_cages", "land_based", "land_based_RAS"],
  "species": ["Atlantic salmon", "chum salmon", "pink salmon", "coho salmon", "chinook salmon", "sockeye salmon", "masu salmon", "rainbow trout", "unspecified salmon species"],
  "fields": {
    "source_id": "string",
    "openalex_id": "string",
    "doi": "string|null",
    "title": "string|null",
    "year": "integer|null",
    "document_type": "enum",
    "review_type": "enum",
    "study_type": "enum",
    "study_design": "array[enum]",
    "research_approach": "enum",
    "setting": "array[enum]",
    "sample_size": "number|string|null",
    "sample_unit": "array[string]",
    "study_period": "string|null",
    "location_region": "string|null",
    "location_country": "string|null",
    "species": "array[enum; required, non-empty]",
    "other_farmed_species": "array[string]",
    "study_population": "string|null",
    "aquaculture_facility": "array[enum]",
    "system_studied": "string|null",
    "production_stage": "array[enum]",
    "fish_life_stage": "array[enum]",
    "impact_type": "array[string]",
    "impact_details": "string|null",
    "outcome_measured": "array[string]",
    "mitigation_evaluation": "string|null",
    "intervention": "string|null",
    "exposure": "string|null",
    "comparator": "string|null",
    "methodology_for_data_collection": "array[string]",
    "funding_body": "string|null",
    "funder": "string|null",
    "research_question": "string|null",
    "objectives_summary": "string|null",
    "ontology_codes": "array[string]",
    "multiple_studies_flag": "boolean",
    "multiple_studies_reason": "string|null",
    "document_completeness_evidence": "string|null"
  },
  "evidence": {
    "description": "For substantive coding, first search Methods/Materials and Results/Findings for explicit evidence. Other sections may support explicit descriptive characteristics when Methods/Results do not state them. For research question and objectives, use the Introduction as needed. For outcome_measured, impact_type, and impact_details, Methods/Materials and Results/Findings, including tables and figure legends/captions, are mandatory evidence sources. Incomplete documents use document_completeness_evidence instead of substantive evidence.",
    "item_schema": {"field": "string", "value": "any", "text": "string", "section": "string", "page": "integer|null"}
  },
  "run_metadata": {
    "schema_version": "string",
    "ontology_version": "string",
    "model": "string",
    "provider": "string",
    "timestamp_utc": "string",
    "source_prepared_file": "string",
    "coding_status": "string"
  }
}
