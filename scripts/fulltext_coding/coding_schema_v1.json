{
  "schema_version": "fulltext_coding_v1",
  "description": "Minimal machine-readable full-text extraction schema aligned as closely as possible with the FRB Blue Food data extraction sheet, with LivingEvidenceMap topic ontology coding added.",
  "document_type": ["study", "review", "systematic_review", "perspective", "commentary", "editorial", "book", "book_chapter", "report", "thesis", "protocol", "other"],
  "review_type": ["systematic", "non_systematic", "not_applicable"],
  "study_type": ["experimental", "observational", "modelling", "not_stated"],
  "study_design": ["BA", "CI", "BACI", "RCT", "Time-series", "Modelling", "Qualitative", "not_stated"],
  "research_approach": ["quantitative", "qualitative", "mixed_methods", "not_applicable"],
  "setting": "array of applicable values; never use 'mixed'. Add multiple values separately when more than one applies. Prefer established spreadsheet terminology and iteratively extend only when a recurring need is demonstrated.",
  "fields": {
    "source_id": "string",
    "openalex_id": "string",
    "doi": "string|null",
    "title": "string|null",
    "year": "integer|null",
    "document_type": "enum",
    "review_type": "enum",
    "study_type": "enum",
    "study_design": "array[enum]",
    "research_approach": "enum",
    "setting": "array[string]",
    "sample_size": "number|string|null",
    "sample_unit": "string|null",
    "study_period": "string|null",
    "location_region": "string|null",
    "location_country": "string|null",
    "species": "array[string]",
    "study_population": "string|null",
    "aquaculture_facility": "array[string]",
    "system_studied": "string|null",
    "production_stage": "array[string]",
    "farming_system": "array[string]",
    "impact_type": "array[string]",
    "impact_details": "string|null",
    "outcome_measured": "array[string]",
    "exposure_pathway": "array[string]",
    "mitigation_evaluation": "string|null",
    "intervention": "string|null",
    "exposure": "string|null",
    "comparator": "string|null",
    "methodology_for_data_collection": "array[string]",
    "funding_body": "string|null",
    "funder": "string|null",
    "research_question": "string|null",
    "objectives_summary": "string|null",
    "ontology_codes": "array[string]"
  },
  "evidence": {
    "description": "For substantive coding, prefer Methods/Materials and Results/Findings. For research question and objectives, use the Introduction as needed, preferring explicit aims/objectives and the latter part of the Introduction. Use the Abstract only as an extreme fallback when the relevant information cannot be found elsewhere in the full text.",
    "item_schema": {"field": "string", "value": "any", "text": "string", "section": "string", "page": "integer|null"}
  },
  "run_metadata": {
    "schema_version": "string",
    "ontology_version": "string",
    "model": "string",
    "provider": "string",
    "timestamp_utc": "string",
    "source_prepared_file": "string",
    "coding_status": "string"
  }
}
